<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ArkPlot.Avalonia.ViewModels"
    xmlns:controls="using:ArkPlot.Avalonia.Views.Controls"
    xmlns:sukiUi="using:SukiUI.Controls"
    xmlns:c="using:CalcBinding"
    mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
    x:Class="ArkPlot.Avalonia.Views.TtsWindow"
    x:DataType="vm:TtsViewModel"
    Title="制作有声书"
    Width="1200" Height="800"
    MinWidth="900" MinHeight="600">

  <Grid ColumnDefinitions="400,*">
    <!-- ======================== 左面板 ======================== -->
    <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <DockPanel Margin="12,8">

        <TextBlock DockPanel.Dock="Top" Text="制作有声书" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding AudiobookStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <!-- ffmpeg 通知条 -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ShowFfmpegNotice}"
                Background="#2080C0FF" BorderBrush="#4080C0FF"
                BorderThickness="1" CornerRadius="6"
                Margin="0,0,0,10" Padding="10,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕"
                    Command="{Binding DismissFfmpegNoticeCommand}"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,2" FontSize="11"
                    IsEnabled="{c:Binding !IsDownloadingFfmpeg}"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="下载"
                    Command="{Binding DownloadFfmpegCommand}"
                    IsEnabled="{c:Binding !IsDownloadingFfmpeg}"
                    Classes="Rounded Accent"
                    VerticalAlignment="Center" Margin="8,0,0,0"
                    Padding="12,4" FontSize="12"/>
            <TextBlock Text="{Binding FfmpegNoticeText}"
                       VerticalAlignment="Center" FontSize="12"
                       TextWrapping="Wrap"/>
          </DockPanel>
        </Border>

        <!-- 小说文件选择 -->
        <TextBlock DockPanel.Dock="Top" Text="1. 小说文件（沿用本次生成结果）" FontSize="12"
                   Opacity="0.6" Margin="0,0,0,4"/>
        <Border DockPanel.Dock="Top" BorderBrush="#30FFFFFF"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"
                MaxHeight="80">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding NovelFiles}" IsEnabled="{Binding !IsGenerating}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Content="{Binding FileName}"
                               IsChecked="{Binding IsSelected}"
                               GroupName="NovelFile"
                               Margin="4,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- 音色配置 -->
        <Button DockPanel.Dock="Top" Content="2. 确认角色音色" IsEnabled="{Binding !IsGenerating}" Margin="0,0,0,8"
                HorizontalAlignment="Stretch" Classes="Rounded">
          <Button.Flyout>
            <Flyout Placement="RightEdgeAlignedTop">
              <Flyout.FlyoutPresenterTheme>
                <ControlTheme TargetType="FlyoutPresenter">
                  <Setter Property="Background"
                      Value="{DynamicResource SukiInformationForeground}" />
                  <Setter Property="CornerRadius" Value="8" />
                  <Setter Property="BorderBrush" Value="Gray" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Padding" Value="12" />
                </ControlTheme>
              </Flyout.FlyoutPresenterTheme>
              <controls:VoiceConfigPanel DataContext="{Binding $parent[Window].((vm:TtsViewModel)DataContext).VoiceConfigPanel}"
                                         Width="500" Height="400"/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Debug 模式 (三击立绘开启) -->
        <Button DockPanel.Dock="Top" Content="🔍 Debug 🔻" Margin="0,0,0,8"
                HorizontalAlignment="Stretch" Classes="Rounded"
                IsVisible="{Binding IsDebugMode}">
          <Button.Flyout>
            <Flyout Placement="Top" ShowMode="Standard">
              <Flyout.FlyoutPresenterTheme>
                <ControlTheme TargetType="FlyoutPresenter">
                  <Setter Property="Background"
                      Value="{DynamicResource SukiInformationForeground}" />
                  <Setter Property="CornerRadius" Value="8" />
                  <Setter Property="BorderBrush" Value="Gray" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Padding" Value="12" />
                </ControlTheme>
              </Flyout.FlyoutPresenterTheme>
              <DockPanel Width="380" MaxHeight="350">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
                  <CheckBox Content="只显示未指定角色 (?)"
                            IsChecked="{Binding $parent[Window].((vm:TtsViewModel)DataContext).ShowUnknownCharactersOnly}"/>
                  <CheckBox Content="只显示无音频行"
                            IsChecked="{Binding $parent[Window].((vm:TtsViewModel)DataContext).ShowNoAudioOnly}"/>
                </StackPanel>
                <ScrollViewer>
                  <TextBlock Text="{Binding $parent[Window].((vm:TtsViewModel)DataContext).DebugInfo}"
                             FontFamily="Consolas,Mono"
                             FontSize="12" TextWrapping="Wrap"
                             Tapped="DebugInfo_Tapped"
                             Cursor="Hand"/>
                </ScrollViewer>
              </DockPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="生成会复用相同文本与音色的缓存；更换音色后需要重新生成。导出会合并为每章一个 MP3。" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
        <Button DockPanel.Dock="Top" Content="打开已导出有声书" Command="{Binding OpenAudioExportFolderCommand}" Margin="0,0,0,8"/>
        <!-- 输出目录 -->
        <TextBlock DockPanel.Dock="Top" Text="输出目录" FontSize="12"
                   Opacity="0.6" Margin="0,0,0,4"/>
        <TextBox DockPanel.Dock="Top" Text="{Binding TtsOutputDir}" IsEnabled="{Binding !IsGenerating}"
                 Margin="0,0,0,8"/>

        <!-- 进度 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,0,0,4"/>
          <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="20"
                       CornerRadius="3"/>
          <TextBlock Text="{Binding TotalProgressText}" FontSize="11"
                     Opacity="0.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,8">
          <Button Content="3. 生成整章音频" Command="{Binding StartGenerateCommand}"
                  IsEnabled="{c:Binding !IsGenerating}"
                  Width="155" Classes="Rounded" Background="#2563EB" Foreground="White"/>
          <Button Content="取消" Command="{Binding CancelCommand}"
                  IsEnabled="{Binding IsGenerating}"
                  Width="120" Classes="Rounded"/>
        </StackPanel>

        <Expander DockPanel.Dock="Top" Header="角色立绘预览" HorizontalAlignment="Stretch">
            <Border Height="180" PointerPressed="PortraitPanel_PointerPressed">
                <controls:PortraitPanel DataContext="{Binding PortraitPanel}"/>
            </Border>
        </Expander>
        <!-- 日志 -->
        <Expander DockPanel.Dock="Top" Header="详细日志" HorizontalAlignment="Stretch">
          <ScrollViewer MaxHeight="200">
            <TextBox Text="{Binding LogText}" IsReadOnly="True"
                     TextWrapping="Wrap" Background="Transparent"
                     FontSize="11" AcceptsReturn="False"/>
          </ScrollViewer>
        </Expander>
        </DockPanel>
      </ScrollViewer>
    </Border>

    <!-- ======================== 右面板 ======================== -->
    <DockPanel Grid.Column="1" Margin="12,8">

      <!-- 顶部: 章节选择 + 搜索 -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
            Margin="0,0,0,8">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Chapters}" IsEnabled="{Binding !IsGenerating}"
                  SelectedItem="{Binding SelectedChapter}"
                  PlaceholderText="选择章节...">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayText}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="◄" IsEnabled="{Binding !IsGenerating}" AutomationProperties.Name="上一章"
                Command="{Binding PrevChapterCommand}" Margin="4,0"/>
        <Button Grid.Column="2" Content="►" IsEnabled="{Binding !IsGenerating}" AutomationProperties.Name="下一章"
                Command="{Binding NextChapterCommand}"/>
      </Grid>

      <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" IsEnabled="{Binding !IsGenerating}"
               Watermark="搜索片段或角色名..." Margin="0,0,0,8"/>

      <!-- 连播控制 -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                  HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,8">
        <Button Content="{Binding PlayButtonText}"
                Command="{Binding PlayFromSelectedCommand}"
                HorizontalAlignment="Center"
                Height="36" MinWidth="180" FontSize="14"
                Classes="Rounded Accent"/>
        <Button Content="⏮ 上一句"
                Command="{Binding PlayPrevCommand}"
                IsEnabled="{Binding IsPlaying}"
                Height="36" Width="100" FontSize="13"
                Classes="Rounded"/>
        <Button Content="下一句 ⏭"
                Command="{Binding PlayNextCommand}"
                IsEnabled="{Binding IsPlaying}"
                Height="36" Width="100" FontSize="13"
                Classes="Rounded"/>
        <Button Content="■ 停止"
                Command="{Binding StopPlayCommand}"
                IsEnabled="{Binding IsPlaying}"
                Height="36" Width="80" FontSize="14"
                Classes="Rounded"/>
      </StackPanel>

      <!-- 片段表格 + Gallery + 导出按钮 -->
      <Grid RowDefinitions="*,Auto,Auto">
        <!-- 片段表格 -->
        <controls:SegmentsDataGrid 
            x:Name="NovelSegments"
            Grid.Row="0" 
            DataContext="{Binding}"/>

        <!-- 场景 Gallery -->
        <Expander Grid.Row="1" Header="场景图片与上下文" HorizontalAlignment="Stretch">
            <controls:GalleryPanel DataContext="{Binding GalleryPanel}"/>
        </Expander>

        <!-- 导出按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
          <Button Content="4. 导出当前章节 MP3" IsEnabled="{Binding !IsGenerating}"
                  Command="{Binding ExportCurrentChapterCommand}"/>
          <Button Content="导出全部章节 MP3" IsEnabled="{Binding !IsGenerating}"
                  Command="{Binding ExportAllChaptersCommand}"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</sukiUi:SukiWindow>
