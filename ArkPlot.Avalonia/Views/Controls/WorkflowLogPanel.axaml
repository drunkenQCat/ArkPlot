<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:suki="using:SukiUI.Controls" xmlns:icons="using:Material.Icons.Avalonia" xmlns:vm="using:ArkPlot.Avalonia.ViewModels" xmlns:models="using:ArkPlot.Avalonia.Models" xmlns:controls="using:ArkPlot.Avalonia.Views.Controls" x:Class="ArkPlot.Avalonia.Views.Controls.WorkflowLogPanel" x:DataType="vm:WorkflowLogPanelViewModel">
    <UserControl.Styles><Style Selector="Button.all.selected"><Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}"/></Style></UserControl.Styles><Grid RowDefinitions="Auto,*" RowSpacing="22">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
                <TextBlock Text="运行日志" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentActivity}" FontSize="12" Foreground="{DynamicResource SukiLowText}" MaxWidth="700" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SukiLowText}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="200,*" ColumnSpacing="18">
            <suki:GlassCard Padding="12,18" IsAnimated="False">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <TextBlock Text="处理阶段" FontSize="15" FontWeight="SemiBold" Margin="8,0"/>
                    <Button Grid.Row="1" Content="全部记录" Classes="Basic all" Classes.selected="{Binding ShowAllStages}" Command="{Binding ShowAllLogsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" x:Name="StageList" Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkflowStage">
                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" Margin="0,7">
                                    <TextBlock Text="{Binding CircleGlyph}" Foreground="{DynamicResource SukiPrimaryColor120}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Duration}" FontSize="10" Foreground="{DynamicResource SukiLowText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SukiLowText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="系统记录" Classes="Basic Small" HorizontalAlignment="Left" Command="{Binding ShowSystemLogsCommand}"/>
                </Grid>
            </suki:GlassCard>
            <suki:GlassCard Grid.Column="1" Padding="20" IsAnimated="False">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
                    <Border IsVisible="{Binding HasErrors}" Padding="12" CornerRadius="10" Background="{DynamicResource SukiAccentColor10}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ErrorSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="定位记录" Classes="Basic Small" Command="{Binding LocateAllErrorsCommand}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Content="导出日志" Classes="Basic Small" Command="{Binding ExportLogsCommand}"/>
                            <Button Content="更多" Classes="Basic Small">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="清空日志" Command="{Binding ClearLogsCommand}"/>
                                        <MenuItem Header="清除所选章节缓存" Command="{Binding ClearCacheCommand}" IsVisible="{Binding IsClearCacheVisible}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20">
                        <CheckBox Content="仅错误" IsChecked="{Binding ShowErrorsOnly}" FontSize="12"/>
                        <CheckBox Content="跟随最新" IsChecked="{Binding FollowLatest}" FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <controls:WorkflowLogStream/>
                        <TextBlock Text="当前范围没有记录。" IsVisible="{Binding !HasVisibleLogs}" Foreground="{DynamicResource SukiLowText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="4" Text="{Binding VisibleLogSummary}" FontSize="10" Foreground="{DynamicResource SukiLowText}"/>
                    <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SukiLowText}"/>
                </Grid>
            </suki:GlassCard>
        </Grid>
    </Grid>
</UserControl>
