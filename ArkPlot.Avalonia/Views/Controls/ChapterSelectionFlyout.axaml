<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkPlot.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="40"
             x:Class="ArkPlot.Avalonia.Views.Controls.ChapterSelectionFlyout"
             x:DataType="vm:MainWindowViewModel">
  <Button
      Content="当前活动🔻"
      VerticalAlignment="Center"
      HorizontalAlignment="Right"
      IsEnabled="{Binding IsInitialized}"
      Command="{Binding LoadChaptersCommand}">
    <Button.Flyout>
      <Flyout>
        <Flyout.FlyoutPresenterTheme>
          <ControlTheme TargetType="FlyoutPresenter">
            <Setter Property="Background"
                    Value="{DynamicResource SukiInformationForeground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
          </ControlTheme>
        </Flyout.FlyoutPresenterTheme>
        <StackPanel Margin="15" MaxWidth="300">
          <TextBlock Text="选择导出章节" FontSize="16" FontWeight="Bold"
                     Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal" Spacing="10"
                      HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="全选" Classes="Rounded Flat"
                    Command="{Binding SelectAllChaptersCommand}"
                    FontSize="12" />
            <Button Content="取消全选" Classes="Rounded Flat"
                    Command="{Binding DeselectAllChaptersCommand}"
                    FontSize="12" />
          </StackPanel>
          <Border BorderThickness="1" BorderBrush="LightGray"
                  MaxHeight="400">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Chapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        FontSize="14"
                        Margin="2"
                        HorizontalAlignment="Stretch">
                      <DockPanel>
                        <TextBlock
                            Text="{Binding ChapterName}"
                            VerticalAlignment="Center" />
                      </DockPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>