<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ArkPlot.Avalonia.ViewModels"
    xmlns:b="using:Avalonia.Xaml.Behaviors"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:c="using:CalcBinding"
    xmlns:sukiUi="using:SukiUI.Controls"
    xmlns:ba="using:ArkPlot.Avalonia.Styles"
    xmlns:controls="using:ArkPlot.Avalonia.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ArkPlot.Avalonia.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="ArkPlot"
    Height="710"
    Width="780">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Window.Styles>
        <Style Selector="RadioButton.Chips:disabled">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="Background" Value="#CCC" />
            <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="RadioButton.Chips:disabled:checked">
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
        </Style>

    </Window.Styles>

    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiToastHost Manager="{Binding ToastManager}" />
    </sukiUi:SukiWindow.Hosts>
    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Opened">
            <ia:InvokeCommandAction Command="{Binding LoadInitResourceCommand}" />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid RowDefinitions="*">
        <Grid ColumnDefinitions="400,*">
        <!-- ============ Column A：banner + 主操作区 ============ -->
        <StackPanel Grid.Column="0">
            <!-- <Column A> -->
            <Grid Height="100">
            <Border
                x:Name="BannerImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Tapped="BannerImage_Tapped">
                <Border.Background>
                    <ImageBrush Source="avares://ArkPlot.Avalonia/Assets/slogan.jpg"
                                Stretch="UniformToFill"
                                AlignmentY="Top"
                    />
                </Border.Background>
            </Border>
        </Grid>
        <Grid
            Margin="10 10 10 0"
            RowDefinitions="*,*,*,*"
        >
            <StackPanel
                Spacing="6"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="6"
                Grid.Row="0">
                <RadioButton
                    Content="插曲"
                    IsChecked="True"
                    Classes="Chips"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    Command="{Binding LoadActsCommand}"
                    CommandParameter="ACTIVITY_STORY" />
                <RadioButton
                    Content="故事集"
                    Classes="Chips"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    Command="{Binding LoadActsCommand}"
                    CommandParameter="MINI_STORY" />
                <RadioButton
                    Classes="Chips"
                    Content="主题曲"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    Command="{Binding LoadActsCommand}"
                    CommandParameter="MAIN_STORY" />
            </StackPanel>
            <StackPanel
                Spacing="5"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Grid.Row="1">
                <RadioButton
                    Content="简中"
                    Classes="Chips"
                    IsChecked="True"
                    Command="{Binding LoadLangTableCommand}"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    CommandParameter="zh_CN" />
                <RadioButton
                    Content="日本語"
                    Classes="Chips"
                    Command="{Binding LoadLangTableCommand}"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    CommandParameter="ja_JP" />
                <RadioButton
                    Content="Eng"
                    Classes="Chips"
                    Command="{Binding LoadLangTableCommand}"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    CommandParameter="en_US" />
                <RadioButton
                    Content="한국어"
                    Classes="Chips"
                    Command="{Binding LoadLangTableCommand}"
                    IsEnabled="{c:Binding !LoadLangTableCommand.IsRunning and IsInitialized}"
                    CommandParameter="ko_KR" />

            </StackPanel>
            <Grid Grid.Row="2"
                Margin="0 10 0 10">
                <Grid Margin="0 4 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:ChapterSelectionFlyout
                        Grid.Row="0"
                        Grid.Column="0"
                        DataContext="{Binding}" />
                    <Button Grid.Row="1" Grid.Column="0"
                        Content="Tags文件"
                        Command="{Binding PickTagFileCommand}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="#FF326CF3"
                        BorderBrush="#FF326CF3" />
                    <Button Grid.Row="2" Grid.Column="0"
                        Content="生成位置"
                        Command="{Binding OpenOutputFolderCommand}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="#FF326CF3"
                        BorderBrush="#FF326CF3"
                        ToolTip.Tip="点击打开输出文件夹" />

                    <ComboBox
                        x:Name="StoryNameCombo"
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{Binding StoriesNames}"
                        MaxDropDownHeight="800"
                        SelectedIndex="{Binding SelectedIndex}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                        Text="{Binding JsonPath}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" />
                    <!-- AllowDrop="True" -->
                    <!-- Drop="JsonPathBox_Drop" -->
                    <!-- PreviewDragOver="TextBox_PreviewDragOver" -->
                    <TextBox Grid.Row="2" Grid.Column="1"
                        Text="{Binding OutputPath}" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False" />
                </Grid>
            </Grid>
            <StackPanel
                Margin="0 0 0 0"
                Grid.Row="3"
                VerticalAlignment="Center">
                <!-- 开始/停止 合并按钮：同位置、互斥显示 -->
                <Panel Margin="0 10 0 10" HorizontalAlignment="Center">
                    <Button
                        IsVisible="{c:Binding !LoadMdCommand.IsRunning}"
                        IsEnabled="{c:Binding !LoadInitResourceCommand.IsRunning and IsInitialized}"
                        VerticalAlignment="Center" Command="{Binding LoadMdCommand}" Width="100">
                        开始
                    </Button>
                    <Button
                        IsVisible="{c:Binding LoadMdCommand.IsRunning}"
                        VerticalAlignment="Center"
                        Command="{Binding StopGenerationCommand}"
                        Width="100"
                        Background="#FFD32F2F"
                        Foreground="White">
                        停止
                    </Button>
                </Panel>
                <Button
                    Margin="0 0 0 10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" Width="100">
                    设置
                </Button>
                <Button
                    x:Name="TTSButton"
                    Margin="0 0 0 10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" Command="{Binding OpenTtsCommand}" Width="140">
                    TTS语音生成
                </Button>
                <CheckBox
                    Content="生成时使用本地资源"
                    IsChecked="{Binding IsLocalResChecked}"
                    Margin="0 -6 16 6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <CheckBox
                    Content="启用小说化生成"
                    IsChecked="{Binding IsNovelizerEnabled}"
                    Margin="0 0 16 11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <CheckBox
                    Content="启用图片描述"
                    IsChecked="{Binding IsPicDescEnabled}"
                    Margin="0 0 16 11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </StackPanel>
            <!-- </Column A> -->
        </Grid>
        </StackPanel>
        <!-- ============ Column B：日志面板 ============ -->
        <Grid
            Grid.Column="1" Margin="7" VerticalAlignment="Stretch"
            RowDefinitions="*,Auto">
            <controls:WorkflowLogPanel
                Grid.Row="0"
                DataContext="{Binding WorkflowLog}"/>
                <Button
                    Grid.Row="1"
                    IsVisible="{Binding HasNetworkError}"
                    Content="停止生成并前往设置 →"
                    Command="{Binding NetworkErrorActionCommand}"
                    Margin="0 4 0 0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF326CF3"
                    Cursor="Hand"
                    FontSize="13">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Foreground" Value="#FF5588FF" />
                            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                        </Style>
                    </Button.Styles>
                </Button>
        </Grid>
        <!-- </Column B> -->
        </Grid>
    </Grid>
</sukiUi:SukiWindow>
