<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sukiUi="using:SukiUI.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:Class="ArkPlot.Avalonia.Views.TestWindow"
    Title="ArkPlot 测试面板"
    Width="1000" Height="760" MinWidth="850" MinHeight="650">

  <TabControl x:Name="TestTabs" Margin="16" SelectedIndex="0">
    <TabItem Header="文本模型测试"/>
    <TabItem Header="图片模型测试"/>
    <TabItem Header="开发选项"/>
    <TabItem Header="立绘组件"/>
    <TabItem Header="音频播放"/>
    <TabItem Header="网络中断"/>
  </TabControl>
</sukiUi:SukiWindow>
